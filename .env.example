# send_mail.py icin SMTP yapilandirmasi.
# Bu dosyayi ".env" olarak kopyalayip kendi bilgilerinizle doldurun.
# ".env" dosyasini ASLA git'e commit etmeyin (.gitignore'a ekleyin).

# Gmail kullaniyorsaniz normal hesap sifreniz degil, 16 haneli "Uygulama Sifresi"
# (App Password) gerekir: https://myaccount.google.com/apppasswords
# (2 Adimli Dogrulama acik olmalidir.)

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ornek_gonderen@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SENDER_NAME=TRSP Proje Botu
